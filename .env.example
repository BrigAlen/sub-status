# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Public URL (NEXT_PUBLIC_* inlined at build). Set APP_URL on Render for runtime OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only runtime app URL (preferred for Google OAuth redirect_uri)
APP_URL=http://localhost:3000

# Auth (required in production)
APP_PASSWORD=change-me-strong-password
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AES-256-GCM key for encrypting OAuth/provider tokens at rest (32 bytes hex = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Web Push VAPID (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: allow mock UI when DATABASE_URL empty (dev only)
ALLOW_MOCK_DATA=true

# Google Calendar OAuth (payment reminders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared secret for POST/GET /api/cron/calendar-reminders
CRON_SECRET=


# Display timezone for dates (default Europe/Moscow). Client: NEXT_PUBLIC_APP_TZ
APP_TZ=Europe/Moscow
NEXT_PUBLIC_APP_TZ=Europe/Moscow
